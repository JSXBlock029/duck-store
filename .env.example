# Copy to .env. Never commit the real file.

# Signs login sessions. Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Required to use the admin area (HTTP Basic auth, any username). If unset, the admin area is disabled.
ADMIN_PASSWORD=

STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
DATABASE_URL=sqlite:///duck_store.db
